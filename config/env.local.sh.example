#!/usr/bin/env bash
# =============================================================================
# env.local.sh.example — template for machine-specific configuration
# =============================================================================
# Copy this file to config/env.local.sh (same directory) and fill in the paths
# for the current machine. env.local.sh is gitignored: it never leaves the
# machine. Find candidate paths with:  tools/doctor.sh --locate <tool>
# Verify the result with:              tools/doctor.sh
#
# Every value is a PATH (file or directory). There is no conda-env activation
# in this mechanism: conda-installed binaries are self-contained and work when
# called by absolute path.
# =============================================================================

# --- Credentials ---------------------------------------------------------------
# NCBI E-utilities contact (recommended; raises API rate limits with a key).
NCBI_EMAIL=""
NCBI_API_KEY=""

# --- Runtime defaults ----------------------------------------------------------
MYS_THREADS=8

# --- Interpreters ----------------------------------------------------------------
# Leave empty to use the one found on PATH.
MYS_PYTHON_BIN=""
MYS_RSCRIPT_BIN=""
# R package library directory (exported as R_LIBS for all R scripts).
MYS_R_LIBS=""

# --- External tools --------------------------------------------------------------
# Empty = fall back to PATH. Set an absolute path to pin a specific binary.
MYS_PREFETCH_BIN=""
MYS_FASTERQ_DUMP_BIN=""
MYS_FASTQ_DUMP_BIN=""
MYS_FASTQC_BIN=""
MYS_PARALLEL_BIN=""
MYS_ASCP_BIN=""
MYS_BLASTN_BIN=""
MYS_BLASTP_BIN=""
MYS_MAKEBLASTDB_BIN=""
MYS_MKDSSP_BIN=""
MYS_PYMOL_BIN=""
MYS_CHIMERAX_BIN=""
MYS_PLINK_BIN=""
MYS_VCFTOOLS_BIN=""
MYS_FEATURECOUNTS_BIN=""
MYS_SAMTOOLS_BIN=""
MYS_BEDTOOLS_BIN=""
MYS_BAMCOVERAGE_BIN=""
MYS_GTF2BED_BIN=""
MYS_GFF2BED_BIN=""

# --- Escape hatch ------------------------------------------------------------------
# Directories prepended to PATH for script subprocesses that look up companion
# binaries by name. Normally leave empty.
MYS_EXTRA_PATH=""
